# TripPilot AI — Environment Configuration
# Copy this file to .env for local testing or set these variables in Render Dashboard

# Google Gemini API key for intelligent natural language travel plan refinement
GEMINI_API_KEY=""

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/trippilot?retryWrites=true&w=majority
MONGODB_URI=""

# JWT Secret for securing user authentication tokens
JWT_SECRET="trippilot_super_secret_jwt_key_2026"

# Frontend URL for CORS authorization in production (e.g., https://trippilot-ai.onrender.com)
FRONTEND_URL="http://localhost:5173"

# Port number for backend service (default 3000 for fullstack Node/Express, 5000 for Flask)
PORT=3000

# Client API Base URL (leave empty for same-origin relative '/api', or specify for separate frontend host)
# Example for separate Vite client: VITE_API_URL=http://localhost:5000/api
VITE_API_URL=""
